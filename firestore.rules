rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Products Collection
    match /products/{productId} {
      allow read, write: if true;
    }

    // 2. Stores Collection
    match /stores/{storeId} {
      allow read, write: if true;
    }

    // 3. Landing Pages Collection
    match /landing_pages/{pageId} {
      allow read, write: if true;
    }

    // 4. Orders Collection
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // 5. Analytics Collection (Daily Aggregated Documents - Zero Heartbeat)
    match /analytics/{dateId} {
      allow read, write: if true;
    }

    // 6. System metadata & Health Check
    match /_system/{docId} {
      allow read, write: if true;
    }

    match /test/{docId} {
      allow read, write: if true;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
