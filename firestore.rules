rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Products Collection: Public read for customers; full write/delete permissions
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // System configuration metadata for store initialization
    match /_system/{docId} {
      allow read, write: if true;
      allow create, update, delete: if true;
    }

    // Orders Collection: Public create for COD customers; read, update and delete
    match /orders/{orderId} {
      allow read: if true;
      allow create: if request.resource.data.customerName is string 
                    && request.resource.data.phoneNumber is string
                    && request.resource.data.city is string
                    && request.resource.data.totalPrice is number;
      allow update, delete: if true;
    }
  }
}

