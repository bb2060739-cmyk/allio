rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Verify if the request comes from an authenticated Admin
    function isAdmin() {
      return request.auth != null;
    }

    // 1. Products Collection:
    // Public can ONLY READ (get/list).
    // ONLY authenticated Admin can CREATE, UPDATE, or DELETE products.
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 2. Stores & Landing Pages Configuration Collection:
    // Public can ONLY READ (get/list).
    // ONLY authenticated Admin can CREATE, UPDATE, or DELETE stores and design configs.
    match /stores/{storeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 3. Orders Collection:
    // Unauthenticated users (the public) are strictly ALLOWED to CREATE documents.
    // Dashboard reads and management are fully permitted so orders never get hidden.
    match /orders/{orderId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if true;
    }

    // 4. System metadata & Health Check
    match /_system/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /test/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

