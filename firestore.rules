rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Products Collection: Public read for customers; full write/delete permissions
    match /products/{productId} {
      allow read, write: if true;
      allow create, update, delete: if true;
    }

    // Orders Collection: Public create for COD customers; full admin read, update, delete
    match /orders/{orderId} {
      allow read, write: if true;
      allow create, update, delete: if true;
    }

    // System configuration metadata for store initialization
    match /_system/{docId} {
      allow read, write: if true;
      allow create, update, delete: if true;
    }

    // Ping / health check collection
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}

